profiles {
  slurm {
    includeConfig 'conf/slurm.config'
  }
  gcp {
    includeConfig 'conf/gcp.config'
  }
  local {
    includeConfig 'conf/local.config'
  }
}

workDir = "gs://shared-aif-bucket-8b96/jobs-tmpfiles/classyflow"

params {
    //Core Pipeline Settings
    help = false
    input_dirs = ["gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/a1", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/b2", 
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/c3",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/d4", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/e5", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/f6", 
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/g7", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/h8", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/i9",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/j10", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/k11", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/L12", 
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/m13", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/n14", 
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/o15", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/p16", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/q17",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/r18", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/s19", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/t20",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/v22",  "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/w23", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/x24",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/y25", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/z26", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/aa27",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/bb28", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/cc29", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/dd30",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/ee31", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/ff32", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/gg33",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/hh34", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/ii35", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/kk36",
    "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/mm37", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/nn38", "gs://shared-aif-bucket-8b96/RaymondDev01/gastric_inputs/oo39"
    ]

    output_dir = "gs://shared-aif-bucket-8b96/RaymondDev01/classyflow_bmsGas"

     
    //Input File formatting configurations
    slide_contains_prefix="True"  /// Assume folder is a batch of slides & image name contains "_" delimited prefix
    folder_is_slide="False"         /// Assume folder contains multiple ROI's to a single slide/sample.
	  quant_file_extension=".tsv"
	  quant_file_delimiter="\\t"  // Tab-delimited '\\t' or comma ','
     
    // 8-bit (pixel values will be 0-255) or 16-bit (pixel values will be 0-65,535)
    // Need to add an option for Dual-Band comingin from Hyperion data (0-e)
    bit_depth="16-bit" 
    
    qupath_object_type="CellObject"  // This has two ROIs & 4 components [Cell, Cytoplasm, Membrane, Nucleus] from QuPath
    //qupath_object_type='DetectionObject' // Single Whole Cell or Nucleus only
    plot_fraction = 0.25
    
    // QuPath's feild holding the cell names
    classifed_column_name="Classification"
    
    // Pipe delimited list of marker names, that regex will exclude (be careful of partial sub-names like CD3 in CD38)
    exclude_markers="Arg1|B2M|BAD|CCAM5|CCR8|CD123|CD209|CD28|CD40|CD69|CD83|CTLA4|DAPI_R28|EGFR|GATA3|Gal3|HLAI|Her2|IDO|ILT4|Ki67|LAG3|NKG2D|NKG7|PD1|PDL1|SURVIVIN|T-BET|TCF7|TIGIT|TIM3|iNOS"
    nucleus_marker="DAPI_AF_R01"
    housekeeping_marker=""
    
    // Set this to blank; if you want the method to decide by QRQ evaluation.
    override_normalization="boxcox" //Options: [null, 'minmax', 'boxcox', 'log', 'quantile'] // null will pick for you, not yet completed.
    downsample_normalization_plots=0.4
    plot_target_feature_suffix="Cell: Mean"
    quantile_split = 1024   // Good for 16-bit, but not be for 255-bit or DualBand / Hyperion

    // Model search space parameters
    max_xgb_cv = 30
    xgb_depth_start = 2
    xgb_depth_stop = 21
    xgb_depth_step = 7
    xgb_learn_rates = "0.1,0.5,1.0" 

    // Prediction Settings
    predict_class_column = 'CellType'
    predict_le_encoder_file = "${params.output_dir}/models/classes.npy"
    predict_columns_to_export = 'Centroid X µm,Centroid Y µm,Image,CellTypePrediction'
    predict_cpu_jobs = 16
    
    // Add clustering for additional feature engineering
    run_get_leiden_clusters=false
    scimap_resolution=0.66 //resolution in https://scimap-doc.readthedocs.io/en/latest/tl/sm.tl.cluster/
    scimap_label_fraction=0.64 //want more than more than 2/3rds label enrich, to impute
    scimap_top_feature_prec=0.1
    
    // How much of the data per batch to with-hold from feature selection and class interpetation
    holdout_fraction=0.1
    filter_out_junk_celltype_labels="??,?,0,Negative,Ignore*,0.0,HLAII,HLAI"
    minimum_label_count=18
    
    // Feature Selection 
    // subset_training_data="True" //This is not working directly.
    //The number of features to use in RFE
    min_rfe_nfeatures = 2
    max_rfe_nfeatures = 56

}


