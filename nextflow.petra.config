/*
Set default parameters

Any parameters provided by the user with a -params-file or
with -- command-line arguments will override the values
defined below.
*/
workDir = "gs://shared-aif-bucket-8b96/jobs-tmpfiles/classyflow"
profiles {
  slurm {
    includeConfig 'conf/slurm.config'
  }
  gcp {
    includeConfig 'conf/gcp.config'
  }
  local {
    includeConfig 'conf/local.config'
  }
}
params {
    help = false
    input_dirs = [
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN1_S1",
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN1_S2",
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN2_S1",
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN2_S2",
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN3_S1",
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN3_S2",
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN4_S1",
    "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/inputs/RUN4_S2",
    ]
    #output_dir = "/home/jupyter/Hirsova/BIC_Analysis/Classyflow/outputs/CLASSYFLOW_round3"
    output_dir = 'gs://shared-aif-bucket-8b96/Rohan/Hirsova/CLASSYFLOW_round4"

    //Input File formatting configurations
    slide_contains_prefix="False"  /// Assume folder is a batch of slides & image name contains "_" delimited prefix
    folder_is_slide="True"         /// Assume folder contains multiple ROI's to a single slide/sample.
        quant_file_extension=".tsv"
        quant_file_delimiter="\\t"  // Tab-delimited '\\t' or comma ','
     
    // 8-bit (pixel values will be 0-255) or 16-bit (pixel values will be 0-65,535)
    // Need to add an option for Dual-Band comingin from Hyperion data (0-e)
    bit_depth="16-bit" 
    
    //qupath_object_type="CellObject"  // This has two ROIs & 4 components [Cell, Cytoplasm, Membrane, Nucleus] from QuPath
    qupath_object_type='DetectionObject' // Single Whole Cell or Nucleus only
    
    // QuPath's feild holding the cell names
    classifed_column_name="Classification"
    
    // Pipe delimited list of marker names, that regex will exclude (be careful of partial sub-names like CD3 in CD38)
    //exclude_markers="KI67|TIGIT|PD-1|PDL-1|PVR|ANNEXINV|ISOTYPE|STING|TENASCINC|CTLA4|LAG3|GP100|MART1|SOX10|S6|TRYPTASE|ANNEXINV|T-bet|TBX21"
    exclude_markers="Ki67|TIGIT|PD1|CD69|PDL1|CCR8|ILT4|BAD|IRR-69|IRR-101|IRR-36"
    nucleus_marker="DAPI"
    housekeeping_marker="S6"
    
    // Set this to blank; if you want the method to decide by QRQ evaluation.
    override_normalization="boxcox" //Options: ['original', 'minmax', 'boxcox', 'log', 'quantile']
    downsample_normalization_plots=0.5
    quantile_split=800 // Good for 16-bit, but not be for 255-bit or DualBand / Hyperion
    
    // How much of the data per batch to with-hold from feature selection and class interpetation
    holdout_fraction=0.05
    filter_out_junk_celltype_labels="??,?,0,Negative,Geometry"
    minimum_label_count=5
    
    // Feature Selection 
    // subset_training_data="True" //This is not working directly.
    //The number of features to use in RFE
    min_rfe_nfeatures = 3
    max_rfe_nfeatures = 35
    
    plot_target_feature_suffix = "png"  // or whatever suffix you want for target feature plots
    target_feature = "Classification"  // This should match your classified_column_name   

    run_get_leiden_clusters = true
    scimap_resolution = 0.5	    
    scimap_label_fraction = 0.1	 
    scimap_top_feature_prec = 0.8

    plot_fraction = 0.5
    run_get_leiden_clusters = true
    plot_target_feature_suffix="Mean"
    // Specifically for XGBoost Modeling variables to contols hyper-parameter tuning
    max_xgb_cv = 40
    
    // XGBoost hyperparameter search ranges
    xgb_depth_start = 3          // Starting depth for grid search
    xgb_depth_stop = 10          // Ending depth for grid search  
    xgb_depth_step = 1           // Step size for depth search
    xgb_learn_rates = "0.01,0.1,0.2,0.3"  // Comma-separated learning rates to test
    predict_cpu_jobs = 16
    params.predict_columns_to_export = "Centroid X µm,Centroid Y µm,Image,CellTypePrediction"   
}