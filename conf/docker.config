// conf/docker.config
//
// Included by the `docker` profile in nextflow.config, which already supplies
// the profile scope -- so these settings are written at the top level here.

// Image to run every process in. Build it first:
//   docker build -f container/Dockerfile -t classyflow:latest .
// For a remote image, use the full registry path instead, e.g.
//   process.container = 'us-central1-docker.pkg.dev/MY_GCP_PROJECT/images/classyflow:latest'
process.container = 'classyflow:latest'

docker.enabled = true
