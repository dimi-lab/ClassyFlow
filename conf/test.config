// conf/test.config
// Small, fast configuration for the end-to-end smoke test. Points the pipeline
// at the bundled sample data (data/) and shrinks the model/feature search space
// so a full run completes quickly. Use with:
//   nextflow run main.nf -profile local -c conf/test.config
//
// NOTE: requires the full requirements.txt environment (Python 3.10/3.11 — the
// container), because the default report stage imports umap (numba stack), which
// does not install on Python 3.12.

process.executor = 'local'
process {
  cpus = 1
  memory = '4 GB'
}

params {
    // Use the two bundled sample batches instead of the gs:// defaults.
    input_dirs = ["${projectDir}/data/TMA1990", "${projectDir}/data/TMAS1_4xB2"]
    output_dir = "${launchDir}/classyflow_test_output"

    // Define the param that main.nf reads but nextflow.config omits.
    batch_correct_column_names = true

    // Shrink the XGBoost hyperparameter grid (fast, still exercises the stage).
    max_xgb_cv = 2
    xgb_depth_start = 2
    xgb_depth_stop = 3
    xgb_depth_step = 1
    xgb_learn_rates = "0.3"

    // Shrink recursive feature elimination.
    min_rfe_nfeatures = 2
    max_rfe_nfeatures = 4
    rfe_step = 2

    // Keep clustering off (avoids the heavy scimap/scanpy path).
    run_get_leiden_clusters = false

    // Data is small; do not split tables round-robin.
    target_splitting_size = ""
}
