profiles {
    slurm {
        includeConfig 'conf/slurm.config'
    }
    gcp {
        includeConfig 'conf/gcp.config'
    }
    local {
        includeConfig 'conf/local.config'
    }
}

workDir = "work"

params {
    // ---- Core pipeline settings ----
    help = false
    input_dirs = ["${projectDir}/data/TMA1990", "${projectDir}/data/TMAS1_4xB2"]
    output_dir = "classyflow_output"

    // ---- Input file layout & formatting ----
    slide_contains_prefix = "False"        // Assume folder is a batch of slides & image name contains "_"-delimited prefix
    folder_is_slide = "True"               // Assume folder contains multiple ROIs belonging to a single slide/sample
    quant_file_extension = ".tsv"
    quant_file_delimiter = "\\t"            // Tab-delimited '\\t' or comma ','

    // qupath_object_type = "CellObject"    // Two ROIs & 4 components [Cell, Cytoplasm, Membrane, Nucleus] from QuPath
    qupath_object_type = "DetectionObject"  // Single whole-cell or nucleus-only object

    // Run the column rename/format fixup stage before analysis (see assets/rename_columns.yaml)
    batch_correct_column_names = false

    classifed_column_name = "Classification"  // QuPath field holding the cell type/name

    // Pipe-delimited list of marker names that regex will exclude
    // (careful of partial sub-name matches, e.g. CD3 in CD38)
    exclude_markers = "Bcl2|Ki67|HLA-A|ER|IDO1|Beta-actin|HLA-DR|PCNA|GzB|Podoplanin|CD45RO|ICOS|LAG3|Irr-61|Irr-66|Irr-96"

    // ---- Normalization ----
    // Leave blank to let the pipeline pick by QRQ evaluation (not yet implemented).
    override_normalization = "boxcox"  // Options: [null, 'minmax', 'boxcox', 'log', 'quantile']
    plot_target_feature_suffix = "Mean"
    quantile_split = 1024  // Good for 16-bit; not ideal for 8-bit or DualBand/Hyperion data

    // ---- Model search space ----
    max_xgb_cv = 10
    xgb_depth_start = 2
    xgb_depth_stop = 9
    xgb_depth_step = 3
    xgb_learn_rates = "0.1,0.7,1.0"

    // ---- Prediction ----
    predict_class_column = "CellType"
    predict_columns_to_export = "Centroid X µm,Centroid Y µm,Image,CellTypePrediction"
    predict_cpu_jobs = 16

    // ---- Leiden clustering (additional feature engineering) ----
    run_get_leiden_clusters = false
    scimap_resolution = 0.66         // https://scimap-doc.readthedocs.io/en/latest/tl/sm.tl.cluster/
    scimap_label_fraction = 0.64     // require > 2/3 label enrichment before imputing
    scimap_top_feature_prec = 0.1

    // ---- Holdout & label filtering ----
    holdout_fraction = 0.1  // fraction of each batch withheld from feature selection & class interpretation
    filter_out_junk_celltype_labels = "??,?,0,Negative,Ignore*"
    minimum_label_count = 18

    // ---- Feature selection (RFE) ----
    min_rfe_nfeatures = 2
    max_rfe_nfeatures = 10
    rfe_step = 2

    // Row count to split batches into, round-robin style, to bound memory usage.
    // Leave blank to avoid splitting (default 1,000,000 rows requires high-mem hardware).
    target_splitting_size = 55000
}
